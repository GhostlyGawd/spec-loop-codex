  "collector": {
    "method": "GitHub MCP read-only",
    "workflow_source": "name: Spec Loop product review\n\non:\n  pull_request:\n  push:\n    branches: [main, codex/background-review, codex/installation-pilot, codex/work-mode]\n  schedule:\n    - cron: '17 7 * * *'\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: product-review-${{ github.ref }}\n  cancel-in-progress: false\n\njobs:\n  review:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    steps:\n      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6\n        with:\n          persist-credentials: false\n      - name: Review committed product inputs\n        env:\n          REVIEW_RUN_ID: review-${{ github.run_id }}-${{ github.run_attempt }}\n        run: >-\n          python3 scripts/review_runner.py run\n          --output \"$RUNNER_TEMP/spec-loop-review\"\n          --run-id \"$REVIEW_RUN_ID\"\n      - name: Validate the published receipt against this checkout\n        env:\n          REVIEW_RUN_ID: review-${{ github.run_id }}-${{ github.run_attempt }}\n        run: >-\n          python3 scripts/review_runner.py status\n          --receipt \"$RUNNER_TEMP/spec-loop-review/$REVIEW_RUN_ID.json\"\n      - name: Publish review summary\n        if: always()\n        run: |\n          python3 - <<'PY'\n          import os\n          from pathlib import Path\n          folder = Path(os.environ['RUNNER_TEMP']) / 'spec-loop-review'\n          with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as stream:\n              reports = sorted(folder.glob('*.md'))\n              if not reports:\n                  stream.write('Product review is unavailable. Inspect the failed or cancelled job.\\n')\n              for report in reports:\n                  stream.write(report.read_text())\n          PY\n      - uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        if: always()\n        with:\n          name: product-review-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/spec-loop-review/\n          if-no-files-found: warn\n          retention-days: 14\n\n  tests:\n    if: github.event_name != 'schedule'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    steps:\n      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6\n        with:\n          persist-credentials: false\n      - name: Run regression tests\n        run: python3 -m unittest discover -s tests -v\n      - name: Check source resources\n        run: python3 scripts/install_check.py --root .\n      - name: Check native project resume\n        run: python3 scripts/spec_loop.py context CHG-006 --max-chars 100000\n      - name: Build the Work skill resource bundle\n        run: python3 scripts/work_bundle.py --root . --output \"$RUNNER_TEMP/spec-loop-work-bundle\"\n      - name: Build and check the source package\n        run: |\n          python3 scripts/package.py --root . --output \"$RUNNER_TEMP/spec-loop-source.tar.gz\"\n          python3 - <<'PY'\n          import os\n          from pathlib import Path\n          import tarfile\n          import subprocess\n          folder = Path(os.environ['RUNNER_TEMP']) / 'spec-loop-extracted'\n          folder.mkdir()\n          with tarfile.open(Path(os.environ['RUNNER_TEMP']) / 'spec-loop-source.tar.gz') as archive:\n              archive.extractall(folder, filter='data')\n          source = folder / 'spec-loop'\n          subprocess.run(['python3', str(source / 'scripts/install_check.py'), '--root', str(source), '--package'], check=True)\n          PY\n      - uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: spec-loop-source-${{ github.sha }}\n          path: ${{ runner.temp }}/spec-loop-source.tar.gz\n          if-no-files-found: error\n          retention-days: 14\n",
    "run_inventory_url": "https://api.github.com/repos/GhostlyGawd/spec-loop-codex/actions/runs?branch=main&per_page=100",
    "note": "All four main-branch runs returned; exact committed workflow read. Job and artifact inventories complete."
  }
}
