{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Loop project v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "enum": [
        "quick",
        "product",
        "critical"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "statement",
          "source"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence_ttl_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8760
    },
    "context_max_chars": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 200000
    }
  },
  "required": [
    "schema_version",
    "name",
    "profile",
    "constraints",
    "evidence_ttl_hours",
    "context_max_chars"
  ],
  "additionalProperties": false
}
