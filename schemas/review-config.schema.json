{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "product_file",
    "signals_file",
    "visibility",
    "max_age_hours"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "native",
        "exchange"
      ]
    },
    "product_file": {
      "type": "string",
      "minLength": 1
    },
    "signals_file": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "max_age_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168
    }
  }
}
