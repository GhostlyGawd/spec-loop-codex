{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signals"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "kind",
          "source",
          "observer",
          "observed_at",
          "privacy",
          "reviewed",
          "result",
          "summary",
          "method",
          "window",
          "max_age_hours"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SIG-[A-Za-z0-9_-]+$"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "feedback",
              "telemetry"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "observer": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          },
          "privacy": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "restricted"
            ]
          },
          "reviewed": {
            "type": "boolean"
          },
          "result": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "neutral",
              "unknown"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "window": {
            "type": "string",
            "minLength": 1
          },
          "max_age_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          }
        }
      }
    }
  }
}
