{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_version",
    "run_id",
    "status",
    "checked_at",
    "expires_at",
    "commit",
    "input_digest",
    "source_hash",
    "mode",
    "roadmap",
    "signals",
    "findings",
    "error",
    "trust",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "failed"
      ]
    },
    "checked_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|)$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|)$"
    },
    "source_hash": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "native",
        "exchange",
        "unknown"
      ]
    },
    "roadmap": {
      "type": "object"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "kind",
          "source",
          "observer",
          "observed_at",
          "privacy",
          "reviewed",
          "result",
          "summary",
          "method",
          "window",
          "max_age_hours",
          "state_at_check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SIG-[A-Za-z0-9_-]+$"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "feedback",
              "telemetry"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "observer": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          },
          "privacy": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "restricted"
            ]
          },
          "reviewed": {
            "type": "boolean"
          },
          "result": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "neutral",
              "unknown"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "window": {
            "type": "string",
            "minLength": 1
          },
          "max_age_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          },
          "state_at_check": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "neutral",
              "unknown",
              "stale"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "type": "string"
    },
    "trust": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
