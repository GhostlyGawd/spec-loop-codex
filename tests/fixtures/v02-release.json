      "contract": {
        "schema_version": 1,
        "id": "CHG-001",
        "title": "Add valid URLs without duplicates",
        "phase": "building",
        "risk": "low",
        "intent": {
          "user": "A person running this local example",
          "problem": "Collect valid web URLs without repeated entries",
          "outcome": "Add a valid URL and receive one list entry",
          "non_goals": [
            "Persistence",
            "Accounts",
            "Network requests",
            "Production deployment",
            "DNS resolution",
            "Complete URL canonicalization"
          ]
        },
        "sources": [
          {
            "id": "SRC-001",
            "kind": "assumption",
            "reference": "README.md — synthetic scenario, not user research",
            "statement": "The local user wants to collect web URLs once."
          }
        ],
        "requirements": [
          {
            "id": "REQ-001",
            "statement": "Accept HTTP and HTTPS URLs with a host. Reject empty input, embedded credentials, internal whitespace or control characters, and malformed or out-of-range ports.",
            "source_ids": [
              "SRC-001"
            ],
            "criteria": [
              {
                "id": "AC-001",
                "statement": "Adding a valid URL with surrounding spaces returns one trimmed URL."
              },
              {
                "id": "AC-002",
                "statement": "An empty URL, unsupported scheme, missing host, embedded credentials, internal whitespace or control characters, or malformed or out-of-range port raises a validation error."
              }
            ]
          },
          {
            "id": "REQ-002",
            "statement": "Repeated additions of the same trimmed URL are idempotent.",
            "source_ids": [
              "SRC-001"
            ],
            "criteria": [
              {
                "id": "AC-003",
                "statement": "Adding the same URL twice leaves exactly one list entry."
              }
            ]
          }
        ],
        "assumptions": [
          {
            "id": "ASM-001",
            "statement": "Exact trimmed string equality is enough for duplicate detection in this example.",
            "impact": "low",
            "status": "accepted",
            "basis": "Explicit teaching scope; URL canonicalization is excluded."
          }
        ],
